# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Use the IPv4 pooler + tenant user for serverless hosts (Vercel).
PGHOST=aws-0-<region>.pooler.supabase.com
PGPORT=6543
PGUSER=postgres.<project-ref>
PGPASSWORD=
PGDATABASE=postgres
# Alternative to the PG* variables above:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Optional: Supabase CA certificate (PEM, "\n"-escaped) to enable full TLS verification.
# DATABASE_CA_CERT=

# ── Sessions ──────────────────────────────────────────────────────────────────
# Long random string (>= 32 chars), e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
# Changing it signs everyone out.
JWT_SECRET=

# ── AI (NVIDIA NIM) ───────────────────────────────────────────────────────────
NVIDIA_API_KEY=
